{
  "openapi": "3.1.1",
  "info": {
    "title": "Tea Auction Upload API",
    "description": "Upload tea auction sale catalogues and list the sales and lots that were accepted.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sales": {
      "get": {
        "tags": [
          "Sales"
        ],
        "summary": "List auction sales",
        "operationId": "ListSales",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SaleSummaryDto"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/sales/{id}": {
      "get": {
        "tags": [
          "Sales"
        ],
        "summary": "Get one sale and its lots",
        "operationId": "GetSale",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SaleDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/uploads": {
      "get": {
        "tags": [
          "Uploads"
        ],
        "summary": "List catalogue uploads",
        "operationId": "ListUploads",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UploadBatchDto"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Uploads"
        ],
        "summary": "Upload a broker catalogue file",
        "operationId": "CreateUpload",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/UploadForm"
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/UploadForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadAcceptedDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/uploads/{id}": {
      "get": {
        "tags": [
          "Uploads"
        ],
        "summary": "Get a pre-auction catalogue upload and its lots",
        "operationId": "GetUpload",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuctionCentre": {
        "enum": [
          "Colombo",
          "Mombasa",
          "Kochi",
          "Jakarta",
          "Kolkata"
        ]
      },
      "BrokerCode": {
        "enum": [
          "AS",
          "BC",
          "CT",
          "EB",
          "FW",
          "JK",
          "LC",
          "MB"
        ]
      },
      "ErrorResponse": {
        "required": [
          "errors"
        ],
        "type": "object",
        "properties": {
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "IFormFile": {
        "type": [
          "null",
          "string"
        ],
        "format": "binary"
      },
      "LotDto": {
        "required": [
          "id",
          "broker",
          "lotNumber",
          "gardenMark",
          "invoiceNumber",
          "grade",
          "bags",
          "netWeightKg",
          "valuationPerKg"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "broker": {
            "$ref": "#/components/schemas/BrokerCode"
          },
          "lotNumber": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "gardenMark": {
            "type": "string"
          },
          "invoiceNumber": {
            "type": "string"
          },
          "grade": {
            "type": "string"
          },
          "bags": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "netWeightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "valuationPerKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "SaleDetailDto": {
        "required": [
          "id",
          "saleNumber",
          "year",
          "centre",
          "saleDate",
          "status",
          "createdAt",
          "lots",
          "uploads"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleNumber": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "centre": {
            "$ref": "#/components/schemas/AuctionCentre"
          },
          "saleDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "$ref": "#/components/schemas/SaleStatus"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LotDto"
            }
          },
          "uploads": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UploadBatchDto"
            }
          }
        }
      },
      "SaleStatus": {
        "enum": [
          "Draft",
          "Open",
          "Closed"
        ]
      },
      "SaleSummaryDto": {
        "required": [
          "id",
          "saleNumber",
          "year",
          "centre",
          "saleDate",
          "status",
          "lotCount",
          "createdAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleNumber": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "centre": {
            "$ref": "#/components/schemas/AuctionCentre"
          },
          "saleDate": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "$ref": "#/components/schemas/SaleStatus"
          },
          "lotCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UploadAcceptedDto": {
        "required": [
          "id",
          "status",
          "saleId"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "saleId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          }
        }
      },
      "UploadBatchDto": {
        "required": [
          "id",
          "saleId",
          "saleNumber",
          "year",
          "centre",
          "saleDate",
          "broker",
          "status",
          "originalFileName",
          "lotCount",
          "error",
          "createdAt",
          "processedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "saleNumber": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "centre": {
            "$ref": "#/components/schemas/AuctionCentre"
          },
          "saleDate": {
            "type": "string",
            "format": "date"
          },
          "broker": {
            "$ref": "#/components/schemas/BrokerCode"
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "originalFileName": {
            "type": "string"
          },
          "lotCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "processedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "UploadDetailDto": {
        "required": [
          "id",
          "saleId",
          "saleNumber",
          "year",
          "centre",
          "saleDate",
          "broker",
          "status",
          "originalFileName",
          "lotCount",
          "error",
          "createdAt",
          "processedAt",
          "lots"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "saleId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "saleNumber": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "centre": {
            "$ref": "#/components/schemas/AuctionCentre"
          },
          "saleDate": {
            "type": "string",
            "format": "date"
          },
          "broker": {
            "$ref": "#/components/schemas/BrokerCode"
          },
          "status": {
            "$ref": "#/components/schemas/UploadStatus"
          },
          "originalFileName": {
            "type": "string"
          },
          "lotCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "error": {
            "type": [
              "null",
              "string"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "processedAt": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "lots": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LotDto"
            }
          }
        }
      },
      "UploadForm": {
        "type": "object",
        "properties": {
          "saleNumber": {
            "type": "string"
          },
          "year": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "centre": {
            "type": "string"
          },
          "saleDate": {
            "type": "string",
            "format": "date"
          },
          "broker": {
            "type": "string"
          },
          "file": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/IFormFile"
              }
            ]
          }
        }
      },
      "UploadStatus": {
        "enum": [
          "Pending",
          "Processing",
          "Completed",
          "Failed"
        ]
      }
    },
    "securitySchemes": {
      "X-Api-Key": {
        "type": "apiKey",
        "description": "Development API key. Send the configured key in the X-Api-Key header.",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "security": [
    {
      "X-Api-Key": [ ]
    }
  ],
  "tags": [
    {
      "name": "Health"
    },
    {
      "name": "Sales"
    },
    {
      "name": "Uploads"
    }
  ]
}